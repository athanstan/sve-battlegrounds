# Copy to .env. Everything here is optional in development.

# Port for the game server (HTTP API and websockets).
PORT=2567

# The one browser origin allowed to call the HTTP API.
WEB_ORIGIN=http://localhost:5173

# Leave unset in development to use the fixture accounts (alice, bob, carol).
# Required in production.
# SHADOWSHOWDOWN_URL=https://shadowshowdown.com
# SHADOWSHOWDOWN_LOGIN_URL=https://shadowshowdown.com/login

# Develop against the shadowrates database: real cards, decks and accounts, read-only.
# SHADOWRATES_DATABASE_URL=postgres://sail:<password>@localhost:5432/shadowrates

# Where card art is fetched from (proxied at /api/art/:file). This is the default.
# CARD_IMAGES_URL=https://shadowshowdown-card-images-ddrngr.s3.eu-north-1.amazonaws.com/cards
