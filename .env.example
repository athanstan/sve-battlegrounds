# Copy to .env to change how `docker compose up` wires things. All optional.

# Ports published on the host. shadowrates already owns 80, 5173, 5432, 6379, 8080, 1025, 8025.
SVE_WEB_PORT=5180
SVE_SERVER_PORT=2567

# shadowrates' database, as seen from inside its Docker network (see shadowrates/.env).
SHADOWRATES_DB_USER=sail
SHADOWRATES_DB_PASSWORD=secret
SHADOWRATES_DB_NAME=shadowrates
